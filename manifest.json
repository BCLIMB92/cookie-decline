{
    "manifest_version": 3,
    "name": "GuardMe",
    "version": "1.0.0",
    "description": "Privacy protections and cookie-consent controls for Firefox.",
    "browser_specific_settings": {
        "gecko": {
            "id": "readai-mozilla-extension@example.com",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "action": {
        "default_title": "GuardMe",
        "default_popup": "popup.html"
    },
    "background": {
        "scripts": ["background.js"]
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["permission-guard.js"],
            "all_frames": true,
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "all_frames": true,
            "run_at": "document_start"
        }
    ],
    "options_ui": { "page": "options.html", "open_in_tab": true },
    "permissions": ["activeTab", "storage", "webRequest", "webRequestBlocking", "browserSettings", "privacy", "browsingData", "downloads", "tabs"],
    "host_permissions": ["<all_urls>"]
}
