{
    "manifest_version": 3,
    "name": "Cookie Consent Guard",
    "version": "0.1.0",
    "description": "A starter Firefox WebExtension.",
    "browser_specific_settings": {
        "gecko": {
            "id": "readai-mozilla-extension@example.com",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "browser_action": {
        "default_title": "Cookie Consent Guard",
        "default_popup": "popup.html"
    },
    "background": {
        "scripts": ["background.js"]
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "all_frames": true
        }
    ],
    "permissions": ["activeTab"]
}
